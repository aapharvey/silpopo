{
  // Cloudflare Worker: веб-застосунок + API + Telegram-бот + збирач цін.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "silpopo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // Статичний веб-інтерфейс (public/). Запити до /api/* і /telegram/* ідуть у Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*", "/oauth/*", "/atb/*"]
  },

  // Вбудований браузер Cloudflare (Browser Run): на безкоштовному тарифі 10 хв на день.
  "browser": { "binding": "BROWSER" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "silpopo",
      // База silpopo в акаунті Cloudflare.
      "database_id": "4cff1bc6-bcb3-4dd4-8405-a83e2c9d21f9",
      "migrations_dir": "migrations"
    }
  ],

  // Безкоштовний тариф: до 5 cron-тригерів на акаунт. Тут два.
  "triggers": {
    "crons": [
      "*/15 * * * *", // збирач цін: маленька порція товарів кожні 15 хв
      "5 * * * *"     // щогодини: перевірка, чи настав час ранкового дайджесту (Київ)
    ]
  },

  // Не видаляти змінні, задані в панелі Cloudflare (ALLOWED_EMAILS, ACCESS_TEAM_DOMAIN, ACCESS_AUD), при кожному деплої.
  "keep_vars": true,

  "vars": {
    // mock — тестові дані без підключення до Сільпо; mcp — офіційний MCP Сільпо.
    "SILPO_MODE": "mcp",
    // password — вхід за паролем (секрет APP_PASSWORD); open — без входу (працює лише в режимі mock); access — Cloudflare Access.
    "AUTH_MODE": "password",
    "SILPO_MCP_URL": "https://mcp.silpo.ua/mcp",
    "TIMEZONE": "Europe/Kyiv",
    "DIGEST_HOUR": "8",
    // Скільки товарів перевіряти за один запуск збирача (ліміт 50 підзапитів на безкоштовному тарифі).
    "COLLECT_BATCH": "12"
  }

  // Задаються в панелі Cloudflare (Worker → Settings → Variables and Secrets), НЕ в цьому файлі:
  //   змінні:  ALLOWED_EMAILS (email через кому), ACCESS_TEAM_DOMAIN, ACCESS_AUD
  //   секрети: APP_PASSWORD, TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET
}
